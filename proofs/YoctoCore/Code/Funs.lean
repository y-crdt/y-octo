    then ok has_left
    else ok false
  let delete_self ←
    if parent_deleted
    then ok true
    else if is_map_entry
         then ok has_right
         else ok false
  if delete_self
  then
    ok
      {
        set_list_start,
        set_map_winner,
        delete_prev_map_winner,
        delete_self,
        add_list_len := false
      }
  else
    if is_map_entry
    then
      ok
        {
          set_list_start,
          set_map_winner,
          delete_prev_map_winner,
          delete_self,
          add_list_len := false
        }
    else
      ok
        {
          set_list_start,
          set_map_winner,
          delete_prev_map_winner,
          delete_self,
          add_list_len := countable
        }

