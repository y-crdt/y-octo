          then ok false
          else
            let after_last ←
              match right.origin_left with
              | none => ok false
              | some origin =>
                if origin.client = left.id.client
                then
                  do
                  let i2 ← left.len - 1#u64
                  let i3 ← left.id.clock + i2
                  ok (origin.clock = i3)
                else ok false
            if after_last
            then
